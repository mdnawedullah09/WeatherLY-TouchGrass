{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "sih": {
      "root": "SIH",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "sih"
      }
    }
  ]
}
